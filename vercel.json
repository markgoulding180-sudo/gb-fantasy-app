{
  "version": 2,
  "name": "gb-fantasy",
  "outputDirectory": "frontend",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/.netlify/functions/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
